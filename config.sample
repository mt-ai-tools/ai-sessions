# Copy this file to `config` beside it and fill it in. `config` is ignored
# by version control: it names your server, and your server is not the
# repository's business.

# The server, as ssh itself takes it: user@address, user@hostname, or a
# Host alias from your own ssh config.
SERVER="user@host"

# Which tmux sessions to show, by their tmux names, separated by spaces.
# Empty shows every tmux session the server keeps running — on a server
# shared with others, name yours here and see only those.
TMUX_SESSIONS=""
