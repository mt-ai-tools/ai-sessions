#!/usr/bin/env bash
# Starts a session on the server, in a folder there, and attaches to it.
# Asks for the name and the folder; the folder is as the server sees it,
# relative to the login user's home or absolute. A folder the server does
# not have is offered to be created, and the session starts only in one
# that exists.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
. "$root/helpers/config.sh"
. "$root/helpers/remote.sh"
. "$root/helpers/sessions-dir.sh"

# What a new session runs. A login shell so the server's own PATH — where a
# per-user tool like claude lives — is the one in effect, and the session
# ends when that command does.
NEW_SESSION_COMMAND='bash -lc claude'

load_config
wipe
read -r -p "session name: " name
[ -n "$name" ] || { echo "both are needed" >&2; exit 1; }
# A name the server already runs is refused here, before the folder is
# asked for: tmux would otherwise keep the running session and only attach.
# The = makes tmux match the name exactly, not as a prefix.
status=0
remote_run "tmux has-session -t $(printf %q "=$name") 2>/dev/null" || status=$?
if [ "$status" -eq "$SSH_LINK_LOST" ]; then
  echo "ai-sessions: could not reach $SERVER" >&2
  exit 1
elif [ "$status" -eq 0 ]; then
  echo "ai-sessions: a session named \"$name\" already runs on the server; pick another name" >&2
  exit 1
fi
echo
echo "Examples:"
printf '%-24s %s\n' "my-folder" "/home/my-user/my-folder" \
                     "~/my-folder" "/home/my-user/my-folder" \
                     "/home/my-user/my-folder" "/home/my-user/my-folder"
echo
read -r -p "work path: " dir
[ -n "$name" ] && [ -n "$dir" ] || { echo "both are needed" >&2; exit 1; }

status=0
resolved="$(resolve_remote_dir "$dir")" || status=$?
if [ "$status" -eq "$SSH_LINK_LOST" ]; then
  echo "ai-sessions: could not reach $SERVER" >&2
  exit 1
elif [ "$status" -ne 0 ]; then
  echo "ai-sessions: no such folder on the server: $dir"
  read -r -p "create it? (yes/no): " answer || answer=""
  if [ "$answer" != "yes" ]; then
    echo "ai-sessions: no session started" >&2
    exit 1
  fi
  make_remote_dir "$dir"
  resolved="$(resolve_remote_dir "$dir")"
fi
dir="$resolved"
# Started detached, then attached through the session's own file, the same
# way as from the folder: one path into a session, and the terminal names
# the tab after the file, that is after the session. -A with -d leaves a
# session of that name alone should one have started since the check above.
remote_run "tmux new-session -A -d -s $(printf %q "$name") -c $(printf %q "$dir") $(printf %q "$NEW_SESSION_COMMAND")"
# The folder is written afresh from the server's listing, so the new
# session's file takes its place among the others. A listing that does not
# come, or leaves the session out, still gets it a file under its own name.
file=""
if raw="$(remote_run "$(list_panes_command)" | filter_listing "${TMUX_SESSIONS:-}")" && [ -n "$raw" ]; then
  clear_session_files
  file="$(printf '%s\n' "$raw" | write_session_files "$name")"
fi
if [ -z "$file" ]; then
  file="$name"
  write_session_file "$name"
fi
exec "$SESSIONS_DIR/$file$SESSION_FILE_SUFFIX"
