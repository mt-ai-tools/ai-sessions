#!/usr/bin/env bash
# The checks, needing nothing installed: the config loads or fails the right
# way, the listing reads as a table, a session file is written to attach by
# name, and refresh reaches the server through ssh and fills the folder.
# The server is a fake ssh on the PATH answering with canned tmux output;
# Tailscale, where asked, is a fake tailscale answering with canned status.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tab=$'\t'

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
# A machine with the Tailscale app installed must not have it answer here.
export TAILSCALE_APP_COMMAND="$tmp/no-such-app"
fail() { echo "FAIL: $1"; exit 1; }
ok() { echo "ok: $1"; }

# A copy of the tool with its own config, so your real config
# and real sessions folder never take part.
cp -R "$root/helpers" "$root/scripts" "$root/config.sample" "$tmp/"
tool="$tmp"

# --- config
out="$(bash -c ". '$tool/helpers/config.sh' && load_config" 2>&1)" && fail "missing config must fail"
case "$out" in *config.sample*) ;; *) fail "missing config must point at the sample" ;; esac
printf '# nothing\n' >"$tool/config"
bash -c ". '$tool/helpers/config.sh' && load_config" 2>/dev/null && fail "config without SERVER must fail"
printf 'SERVER="dev@fake"\n' >"$tool/config"
out="$(bash -c ". '$tool/helpers/config.sh' && load_config && printf '%s' \"\$SERVER\"")"
[ "$out" = "dev@fake" ] || fail "complete config must load SERVER"
out="$(bash -c ". '$tool/helpers/config.sh' && load_config && printf '%s|%s|%s' \"\$TMUX_SESSIONS\" \"\$FORWARD_PORTS\" \"\$TAILSCALE_NODE\"")"
[ "$out" = "||" ] || fail "keys the config leaves out must load empty (got '$out')"
printf 'SERVER="dev@fake"\nFORWARD_PORTS="3000 abc"\n' >"$tool/config"
bash -c ". '$tool/helpers/config.sh' && load_config" 2>/dev/null && fail "a FORWARD_PORTS entry that is not a port must fail"
printf 'SERVER="dev@fake"\nFORWARD_PORTS="3000 70000"\n' >"$tool/config"
bash -c ". '$tool/helpers/config.sh' && load_config" 2>/dev/null && fail "a port above 65535 must fail"
printf 'SERVER="dev@fake"\n' >"$tool/config"
ok "config"

# --- forwards: the config's ports ride on the terminal path and not on the
# listing path. The fake ssh records every argument it is given.
out="$(bash -c ". '$root/helpers/remote.sh' && FORWARD_PORTS='3000 8080' && set_forward_flags && printf '%s ' \"\${FORWARD_FLAGS[@]}\"")"
[ "$out" = "-L 3000:localhost:3000 -L 8080:localhost:8080 " ] || fail "ports must become one -L each, same number both ends (got '$out')"
out="$(bash -c ". '$root/helpers/remote.sh' && FORWARD_PORTS='' && set_forward_flags && printf '%s' \"\${#FORWARD_FLAGS[@]}\"")"
[ "$out" = "0" ] || fail "no ports must mean no flags"
mkdir -p "$tmp/argbin"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$@" >"$FAKE_ARGS"\n' >"$tmp/argbin/ssh"
chmod +x "$tmp/argbin/ssh"
export FAKE_ARGS="$tmp/ssh.args"
PATH="$tmp/argbin:$PATH" bash -c ". '$root/helpers/remote.sh' && SERVER=dev@fake FORWARD_PORTS='3000' && remote_terminal true"
grep -qx -- "3000:localhost:3000" "$FAKE_ARGS" || fail "attaching must carry the forward (got '$(tr '\n' ' ' <"$FAKE_ARGS")')"
PATH="$tmp/argbin:$PATH" bash -c ". '$root/helpers/remote.sh' && SERVER=dev@fake FORWARD_PORTS='3000' && remote_run true"
grep -q -- "localhost:3000" "$FAKE_ARGS" && fail "a listing must not carry forwards"
PATH="$tmp/argbin:$PATH" bash -c "set -u; . '$root/helpers/remote.sh' && SERVER=dev@fake FORWARD_PORTS='' && remote_terminal true" || fail "no forwards must still attach under set -u"
ok "forwards"

# --- listing
out="$(bash -c ". '$root/helpers/listing.sh' && printf '%s\n' 'notes${tab}/home/me/notes${tab}claude${tab}0' | format_listing")"
case "$out" in SESSION*FOLDER*RUNS*OPENED*) ;; *) fail "table must be headed (got '$out')" ;; esac
case "$out" in *notes*~/notes*claude*) ;; *) fail "listing row not formatted (got '$out')" ;; esac
case "$out" in *" -") ;; *) fail "unattached must show as -" ;; esac
out="$(bash -c ". '$root/helpers/listing.sh' && printf '%s\n' 'notes${tab}/x${tab}claude${tab}1' | format_listing")"
case "$out" in *yes) ;; *) fail "attached must say yes" ;; esac
# Deeper folders keep every level below the home.
out="$(bash -c ". '$root/helpers/listing.sh' && printf '%s\n' 'notes${tab}/home/me/a/b${tab}claude${tab}0' | format_listing")"
case "$out" in *"~/a/b"*) ;; *) fail "home shortening must keep deeper levels (got '$out')" ;; esac
# Columns are as wide as their longest cell, heading included, plus the gap:
# every line puts the folder at the same offset.
out="$(bash -c ". '$root/helpers/listing.sh' && printf '%s\n' 'a${tab}/x${tab}claude${tab}0' 'a-much-longer-name${tab}/y${tab}sh${tab}1' | format_listing")"
offsets="$(printf '%s\n' "$out" | awk 'NR == 1 { print index($0, "FOLDER") } NR == 2 { print index($0, "/x") } NR == 3 { print index($0, "/y") }' | sort -u | wc -l | tr -d ' ')"
[ "$offsets" = "1" ] || fail "columns must line up across heading and rows (got '$out')"
case "$out" in *"a-much-longer-name   /y"*) ;; *) fail "gap after the longest cell must be exactly three spaces (got '$out')" ;; esac
out="$(bash -c ". '$root/helpers/listing.sh' && list_panes_command")"
case "$out" in *"tmux list-panes -a -F"*"|| true") ;; *) fail "server asked in tmux's format, quiet without a server" ;; esac
out="$(bash -c ". '$root/helpers/listing.sh' && printf '%s\n' 'notes${tab}/a${tab}claude${tab}0' 'recipes${tab}/b${tab}claude${tab}0' | filter_listing 'recipes other'")"
case "$out" in recipes*) ;; *) fail "filter must keep only the named sessions (got '$out')" ;; esac
case "$out" in *notes*) fail "filter must drop sessions not named" ;; esac
out="$(bash -c ". '$root/helpers/listing.sh' && printf '%s\n' 'notes${tab}/a${tab}claude${tab}0' 'recipes${tab}/b${tab}claude${tab}0' | filter_listing ''")"
case "$out" in *notes*recipes*) ;; *) fail "an empty filter must keep everything" ;; esac
ok "listing"

# --- session file
bash -c ". '$tool/helpers/sessions-dir.sh' && write_session_file notes"
[ -x "$tool/sessions/notes" ] || fail "session file must be written and runnable"
grep -q "attach.sh" "$tool/sessions/notes" || fail "session file must hand over to the attach helper"
grep -q "notes" "$tool/sessions/notes" || fail "session file must carry its name"
ok "session file"

# --- refresh, with a fake ssh answering for the server
mkdir "$tmp/fakebin"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" %q\n' $'notes\t/home/me/notes\tclaude\t0\nrecipes\t/home/me/recipes\tclaude\t1' >"$tmp/fakebin/ssh"
chmod +x "$tmp/fakebin/ssh"
refresh() { PATH="$tmp/fakebin:$PATH" bash -c ". '$tool/helpers/config.sh' && load_config && export SERVER TMUX_SESSIONS=\${TMUX_SESSIONS:-} && bash '$tool/helpers/refresh.sh'"; }
out="$(refresh)"
case "$out" in *notes*recipes*) ;; *) fail "refresh must print the table (got '$out')" ;; esac
[ -x "$tool/sessions/notes" ] && [ -x "$tool/sessions/recipes" ] || fail "refresh must write one file per session"
printf '#!/usr/bin/env bash\nprintf ""\n' >"$tmp/fakebin/ssh"
out="$(refresh)"
case "$out" in *"no tmux sessions running on dev@fake"*) ;; *) fail "no sessions must be said plainly" ;; esac
[ -e "$tool/sessions/notes" ] && fail "refresh must clear files for sessions that are gone"
ok "refresh"

# --- the clock: the default holds when the config is silent, the config wins
out="$(bash -c ". '$tool/helpers/config.sh' && load_config && printf '%s' \"\$REFRESH_SECONDS\"")"
[ "$out" = "30" ] || fail "refresh seconds must default to half a minute (got '$out')"
printf 'SERVER="dev@fake"\nREFRESH_SECONDS=5\n' >"$tool/config"
out="$(bash -c ". '$tool/helpers/config.sh' && load_config && printf '%s' \"\$REFRESH_SECONDS\"")"
[ "$out" = "5" ] || fail "config must set the refresh seconds (got '$out')"
ok "clock"

# --- tailscale: what the status says about the server, read by name, DNS
# name or address; stepped over entirely when there is no tailscale here.
# The fixture is shaped like tailscale status --json, nested parts included.
mkdir -p "$tmp/tsbin"
cat >"$tmp/tsbin/tailscale" <<'EOR'
#!/usr/bin/env bash
[ -f "$FAKE_TS_HANG" ] && sleep 60
[ -f "$FAKE_TS_FAILS" ] && { echo "failed to connect to local tailscaled" >&2; exit 1; }
state="Running"; [ -f "$FAKE_TS_STOPPED" ] && state="Stopped"; [ -f "$FAKE_TS_LOGGED_OUT" ] && state="NeedsLogin"
cat <<EOJ
{
  "Version": "1.80.0",
  "BackendState": "$state",
  "Self": {
    "HostName": "laptop",
    "DNSName": "laptop.tail1234.ts.net.",
    "TailscaleIPs": [
      "100.64.0.1"
    ],
    "Online": true,
    "CapMap": {
      "https://tailscale.com/cap/x": null
    }
  },
  "Health": [],
  "Peer": {
    "nodekey:aaa": {
      "HostName": "other",
      "DNSName": "other.tail1234.ts.net.",
      "TailscaleIPs": [
        "100.64.0.9"
      ],
      "CurAddr": "",
      "Relay": "fra",
      "Online": false,
      "Expired": true,
      "KeyExpiry": "2020-01-01T00:00:00Z"
    },
    "nodekey:bbb": {
      "HostName": "myserver",
      "DNSName": "myserver.tail1234.ts.net.",
      "TailscaleIPs": [
        "100.64.0.2",
        "fd7a::2"
      ],
      "CurAddr": "1.2.3.4:41641",
      "Relay": "fra",
      "Online": true,
      "CapMap": {
        "a": null
      }
    },
    "nodekey:ccc": {
      "HostName": "sleeper",
      "DNSName": "sleeper.tail1234.ts.net.",
      "TailscaleIPs": [
        "100.64.0.3"
      ],
      "CurAddr": "",
      "Relay": "fra",
      "Online": false,
      "KeyExpiry": "2099-01-01T00:00:00Z"
    }
  }
}
EOJ
EOR
chmod +x "$tmp/tsbin/tailscale"
export FAKE_TS_HANG="$tmp/ts-hang" FAKE_TS_STOPPED="$tmp/ts-stopped" FAKE_TS_FAILS="$tmp/ts-fails" FAKE_TS_LOGGED_OUT="$tmp/ts-logged-out"
# Run as attach and check run it, under set -e, with temp files kept where
# they can be counted afterwards.
mkdir -p "$tmp/tsTMP"
ts() { TMPDIR="$tmp/tsTMP" PATH="$tmp/tsbin:$PATH" TAILSCALE_NODE="$1" bash -c "set -euo pipefail; . '$root/helpers/tailscale.sh' && $2"; }
for node in myserver myserver.tail1234.ts.net 100.64.0.2 fd7a::2; do
  out="$(ts "$node" 'tailscale_reason')"
  case "$out" in *"reachable in the tailnet"*) ;; *) fail "$node must be found and reachable (got '$out')" ;; esac
done
out="$(ts myserver 'tailscale_peer && tailscale_path')"
[ "$out" = "direct" ] || fail "an address in use must read as a direct path (got '$out')"
out="$(ts myserver 'tailscale_peer; tailscale_expiry_days || echo "rc=$?"')"
[ "$out" = "rc=1" ] || fail "no KeyExpiry must read as expiry disabled (got '$out')"
out="$(ts sleeper 'tailscale_reason')"
case "$out" in *"offline in the tailnet"*) ;; *) fail "an offline server must be said (got '$out')" ;; esac
out="$(ts sleeper 'tailscale_peer && tailscale_path')"
[ "$out" = "relayed via fra" ] || fail "no address must read as relayed (got '$out')"
out="$(ts sleeper 'tailscale_peer && tailscale_expiry_days')"
[ "$out" -gt 26000 ] || fail "days to expiry must be counted (got '$out')"
out="$(ts other 'tailscale_reason')"
case "$out" in *"key has expired"*) ;; *) fail "an expired key must be said before offline (got '$out')" ;; esac
out="$(ts nope 'tailscale_reason')"
case "$out" in *"not in this tailnet as nope"*) ;; *) fail "a name the tailnet lacks must be said (got '$out')" ;; esac
touch "$FAKE_TS_STOPPED"
out="$(ts myserver 'tailscale_reason')"
case "$out" in *"not running on this machine"*"Stopped"*) ;; *) fail "a stopped tailscale must be said with its state (got '$out')" ;; esac
rm -f "$FAKE_TS_STOPPED"
touch "$FAKE_TS_LOGGED_OUT"
out="$(ts myserver 'tailscale_reason')"
[ "$out" = "tailscale on this machine is logged out" ] || fail "a logged-out tailscale must be said as that (got '$out')"
rm -f "$FAKE_TS_LOGGED_OUT"
touch "$FAKE_TS_FAILS"
out="$(ts myserver 'tailscale_reason')"
[ "$out" = "tailscale is not running on this machine" ] || fail "a tailscale command that fails must read as not running (got '$out')"
rm -f "$FAKE_TS_FAILS"
out="$(ts '' 'tailscale_reason || echo "rc=$?"')"
[ "$out" = "rc=1" ] || fail "no TAILSCALE_NODE must mean no reason (got '$out')"
out="$(PATH="/usr/bin:/bin" TAILSCALE_NODE=myserver bash -c "set -e; . '$root/helpers/tailscale.sh' && { tailscale_reason || echo \"rc=\$?\"; }")"
[ "$out" = "rc=1" ] || fail "no tailscale command must mean no reason (got '$out')"
out="$(PATH="/nonexistent:/usr/bin:/bin" TAILSCALE_APP_COMMAND="$tmp/tsbin/tailscale" TAILSCALE_NODE=myserver bash -c ". '$root/helpers/tailscale.sh' && tailscale_reason")"
case "$out" in *"reachable in the tailnet"*) ;; *) fail "the macOS app's own command must be found off the PATH (got '$out')" ;; esac
touch "$FAKE_TS_HANG"
out="$(ts myserver 'tailscale_reason')"
case "$out" in *"not running on this machine") ;; *) fail "a tailscale that never answers must be given up on and read as not running (got '$out')" ;; esac
rm -f "$FAKE_TS_HANG"
[ -z "$(ls -A "$tmp/tsTMP")" ] || fail "no temp file may be left behind, hung or failed (left: $(ls "$tmp/tsTMP"))"
out="$(bash -c ". '$root/helpers/tailscale.sh' && printf '%s %s %s' \$(days_since_epoch 1970-01-01) \$(days_since_epoch 2000-03-01) \$(days_since_epoch 2026-09-06)")"
[ "$out" = "0 11017 20702" ] || fail "day counting must match the calendar (got '$out')"
ok "tailscale"

# --- watch: one round against the fake server prints the header and the
# table. Started in the background and stopped after a moment, since it
# never ends on its own.
printf '#!/usr/bin/env bash\nprintf "%%s\\n" %q\n' $'notes\t/home/me/notes\tclaude\t0' >"$tmp/fakebin/ssh"
printf 'SERVER="dev@fake"\nREFRESH_SECONDS=1\n' >"$tool/config"
PATH="$tmp/fakebin:$PATH" bash "$tool/scripts/watch-sessions" >"$tmp/watch.out" 2>&1 &
watch_pid=$!
sleep 2
kill "$watch_pid" 2>/dev/null || true
wait "$watch_pid" 2>/dev/null || true
out="$(tr -d '\033' <"$tmp/watch.out")"
case "$out" in *"tmux sessions on:"*"dev@fake"*) ;; *) fail "watch must print its header (got '$out')" ;; esac
case "$out" in *"refresh rate:"*"1s"*) ;; *) fail "watch must show the refresh rate" ;; esac
case "$out" in *SESSION*notes*~/notes*) ;; *) fail "watch must print the table (got '$out')" ;; esac
ok "watch"

# --- new: the folder is resolved on the server before the session starts,
# and a folder the server does not have stops it. The fake ssh answers the
# resolving with a path and records every tmux command it is handed.
cat >"$tmp/fakebin/ssh" <<'EOR'
#!/usr/bin/env bash
cmd="${*: -1}"
case "$cmd" in
  *"cd -- "*) [ -f "$FAKE_NO_SUCH_DIR" ] || printf '/home/me/notes\n' ;;
  *"tmux new-session"*|*"tmux attach"*) printf '%s\n' "$cmd" >>"$FAKE_TMUX_LOG" ;;
esac
EOR
chmod +x "$tmp/fakebin/ssh"
export FAKE_TMUX_LOG="$tmp/tmux.log" FAKE_NO_SUCH_DIR="$tmp/no-such-dir"
printf 'SERVER="dev@fake"\n' >"$tool/config"
rm -rf "$tool/sessions"; rm -f "$FAKE_TMUX_LOG"
printf 'notes\n~/notes\n' | PATH="$tmp/fakebin:$PATH" bash "$tool/scripts/new-session" >/dev/null 2>&1 || fail "new must start a session in an existing folder"
grep -q -- "tmux new-session -A -d -s notes -c /home/me/notes" "$FAKE_TMUX_LOG" || fail "new must start the session detached in the resolved folder (got '$(cat "$FAKE_TMUX_LOG")')"
[ -x "$tool/sessions/notes" ] || fail "new must write the session's file"
grep -q -- "tmux attach -t notes" "$FAKE_TMUX_LOG" || fail "new must attach through the session's file (got '$(cat "$FAKE_TMUX_LOG")')"
grep -q -- "set-titles-string \"#S\"" "$FAKE_TMUX_LOG" || fail "new must have tmux title the terminal after the session (got '$(cat "$FAKE_TMUX_LOG")')"
touch "$FAKE_NO_SUCH_DIR"; rm -f "$FAKE_TMUX_LOG"; rm -rf "$tool/sessions"
out="$(printf 'notes\nnope\n' | PATH="$tmp/fakebin:$PATH" bash "$tool/scripts/new-session" 2>&1)" && fail "new must refuse a folder the server does not have"
case "$out" in *"no such folder on the server: nope"*) ;; *) fail "new must say which folder is missing (got '$out')" ;; esac
[ -e "$FAKE_TMUX_LOG" ] && fail "new must not start a session in a missing folder"
[ -e "$tool/sessions/notes" ] && fail "new must not write a file for a session it did not start"
ok "new"

# --- attach: a session file puts the terminal into its session by name,
# and has tmux title the terminal after it. The helper runs as the file's
# child, so a terminal naming the tab after its command names the session.
rm -f "$FAKE_TMUX_LOG"
bash -c ". '$tool/helpers/sessions-dir.sh' && write_session_file notes"
grep -q -- "^exec" "$tool/sessions/notes" && fail "session file must keep its own name as the command, not exec the helper"
PATH="$tmp/fakebin:$PATH" bash "$tool/sessions/notes" >/dev/null 2>&1 || fail "a session file must attach"
grep -q -- "tmux attach -t notes" "$FAKE_TMUX_LOG" || fail "attach must name its session (got '$(cat "$FAKE_TMUX_LOG")')"
grep -q -- "set-titles-string \"#S\"" "$FAKE_TMUX_LOG" || fail "attach must have tmux title the terminal after the session (got '$(cat "$FAKE_TMUX_LOG")')"
ok "attach"

# --- reconnect: a link lost mid-session is attached again; a session the
# server no longer has is not. The fake ssh drops the link on the first
# attach and answers the second, keeping count in a file; then it says the
# session is gone, as tmux would, and attach must take that answer.
cat >"$tmp/fakebin/ssh" <<'EOR'
#!/usr/bin/env bash
cmd="${*: -1}"
printf '%s\n' "$cmd" >>"$FAKE_TMUX_LOG"
[ -f "$FAKE_SESSION_GONE" ] && { echo "can't find session" >&2; exit 1; }
[ -f "$FAKE_DROPPED" ] || { touch "$FAKE_DROPPED"; exit 255; }
EOR
chmod +x "$tmp/fakebin/ssh"
export FAKE_DROPPED="$tmp/dropped" FAKE_SESSION_GONE="$tmp/session-gone"
rm -f "$FAKE_TMUX_LOG"
out="$(PATH="$tmp/fakebin:$PATH" bash "$tool/sessions/notes" 2>&1)" || fail "attach must ride out a lost link (got '$out')"
[ "$(grep -c "tmux attach -t notes" "$FAKE_TMUX_LOG")" = "2" ] || fail "attach must attach again after the link is lost (got '$(cat "$FAKE_TMUX_LOG")')"
case "$out" in *"link to dev@fake lost"*"notes"*) ;; *) fail "a lost link must be said, naming the session (got '$out')" ;; esac
touch "$FAKE_SESSION_GONE"; rm -f "$FAKE_TMUX_LOG"
PATH="$tmp/fakebin:$PATH" bash "$tool/sessions/notes" >/dev/null 2>&1 && fail "attach must fail when the server has no such session"
[ "$(grep -c "tmux attach -t notes" "$FAKE_TMUX_LOG")" = "1" ] || fail "a session the server lacks must not be retried (got '$(cat "$FAKE_TMUX_LOG")')"
ok "reconnect"

# --- reconnect, away: the wait grows while the link stays lost, and what
# Tailscale knows is said with it. The fake ssh drops the link twice, then
# says the session is gone. Without a tailscale here, nothing more is said.
cat >"$tmp/fakebin/ssh" <<'EOR'
#!/usr/bin/env bash
[ -f "$FAKE_SESSION_GONE" ] && { echo "can't find session" >&2; exit 1; }
n=0; [ -f "$FAKE_DROPPED" ] && n="$(cat "$FAKE_DROPPED")"
n=$((n + 1)); printf '%s' "$n" >"$FAKE_DROPPED"
[ "$n" -ge 2 ] && touch "$FAKE_SESSION_GONE"
exit 255
EOR
chmod +x "$tmp/fakebin/ssh"
rm -f "$FAKE_DROPPED" "$FAKE_SESSION_GONE"
printf 'SERVER="dev@fake"\nTAILSCALE_NODE="sleeper"\n' >"$tool/config"
out="$(PATH="$tmp/fakebin:$tmp/tsbin:$PATH" bash "$tool/sessions/notes" 2>&1)" && fail "the session gone after two drops must still end the attach"
case "$out" in *"reconnecting in 3s"*"reconnecting in 6s"*) ;; *) fail "the wait must grow while the link stays lost (got '$out')" ;; esac
[ "$(printf '%s\n' "$out" | grep -c "offline in the tailnet")" = "2" ] || fail "what tailscale knows must be said with each wait (got '$out')"
rm -f "$FAKE_DROPPED" "$FAKE_SESSION_GONE"
printf 'SERVER="dev@fake"\n' >"$tool/config"
out="$(PATH="$tmp/fakebin:$tmp/tsbin:$PATH" bash "$tool/sessions/notes" 2>&1)" || true
case "$out" in *tailnet*) fail "without TAILSCALE_NODE nothing about tailscale must be said (got '$out')" ;; esac
case "$out" in *"reconnecting in 3s"*) ;; *) fail "the plain lost-link message must stay (got '$out')" ;; esac
ok "reconnect away"

# --- reconnect, terminal: a link lost mid-session leaves the terminal as
# the session had it, mouse reporting on, and the mouse then types reports
# into the window that the next ssh would hand on as keystrokes. So before
# the loss is said the reporting is switched off and pending input thrown
# away. This needs a terminal, made here with script, and fed the reports
# as a session would have left them; the fake ssh lets them land, drops
# the link, and on the next attach reads what its terminal still holds.
# Only the BSD script takes a command this way; elsewhere this is skipped.
if script -q /dev/null true >/dev/null 2>&1; then
  cat >"$tmp/fakebin/ssh" <<'EOR'
#!/usr/bin/env bash
[ -f "$FAKE_DROPPED" ] || { sleep 1; touch "$FAKE_DROPPED"; exit 255; }
stty -icanon min 0 time 3; dd bs=4096 count=1 2>/dev/null | tr -d '\004' >"$FAKE_STDIN_LOG"; stty sane
echo "can't find session" >&2; exit 1
EOR
  chmod +x "$tmp/fakebin/ssh"
  export FAKE_STDIN_LOG="$tmp/ssh.stdin"
  rm -f "$FAKE_DROPPED" "$FAKE_STDIN_LOG"
  out="$(printf '\033[<35;62;43M\033[<35;63;42M' | PATH="$tmp/fakebin:$PATH" script -q /dev/null bash "$tool/sessions/notes" 2>&1)" || true
  case "$out" in *$'\033[?1000l'*$'\033[?1006l'*"link to dev@fake lost"*) ;; *) fail "mouse reporting must be switched off before a lost link is said (got '$(printf '%s' "$out" | cat -v)')" ;; esac
  [ -f "$FAKE_STDIN_LOG" ] || fail "the second attach must have run under a terminal"
  [ ! -s "$FAKE_STDIN_LOG" ] || fail "reports typed while the link was lost must not reach the session (got '$(cat -v "$FAKE_STDIN_LOG")')"
  ok "reconnect terminal"
else
  ok "reconnect terminal (skipped: no BSD script to make a terminal)"
fi

# --- check: every question answered against the fakes, ready or not.
cat >"$tmp/fakebin/ssh" <<'EOR'
#!/usr/bin/env bash
[ -f "$FAKE_SSH_DOWN" ] && exit 255
cmd="${*: -1}"
case "$cmd" in *tmux*) [ -f "$FAKE_NO_TMUX" ] && exit 1 ;; esac
exit 0
EOR
chmod +x "$tmp/fakebin/ssh"
export FAKE_SSH_DOWN="$tmp/ssh-down" FAKE_NO_TMUX="$tmp/no-tmux"
rm -f "$FAKE_SSH_DOWN" "$FAKE_NO_TMUX"
printf 'SERVER="dev@fake"\nFORWARD_PORTS="65001"\nTAILSCALE_NODE="myserver"\n' >"$tool/config"
out="$(PATH="$tmp/fakebin:$tmp/tsbin:$PATH" bash "$tool/scripts/check" 2>&1)" || fail "a ready server must pass the check (got '$out')"
case "$out" in *"in the tailnet as myserver.tail1234.ts.net"*"online in the tailnet"*"does not expire"*"ssh reaches dev@fake"*"path is direct"*"tmux is on the server"*"claude is on the server"*"65001 is free"*ready) ;; *) fail "check must answer every question in order (got '$out')" ;; esac
printf 'SERVER="dev@fake"\nTAILSCALE_NODE="sleeper"\n' >"$tool/config"
touch "$FAKE_SSH_DOWN"
out="$(PATH="$tmp/fakebin:$tmp/tsbin:$PATH" bash "$tool/scripts/check" 2>&1)" && fail "an unreachable server must fail the check"
case "$out" in *"FAIL:  server is offline"*"FAIL:  ssh does not reach"*"not ready") ;; *) fail "check must say what failed (got '$out')" ;; esac
[ "$(printf '%s\n' "$out" | grep -c "offline in the tailnet")" = "1" ] || fail "a reason already given must not be repeated (got '$out')"
rm -f "$FAKE_SSH_DOWN"; touch "$FAKE_NO_TMUX"
printf 'SERVER="dev@fake"\n' >"$tool/config"
out="$(PATH="$tmp/fakebin:$PATH" bash "$tool/scripts/check" 2>&1)" && fail "a server without tmux must fail the check"
case "$out" in *tailnet*) fail "without TAILSCALE_NODE the check must not mention tailscale (got '$out')" ;; esac
case "$out" in *"FAIL:  tmux is not on the server"*) ;; *) fail "missing tmux must be said (got '$out')" ;; esac
rm -f "$FAKE_NO_TMUX"
ok "check"

echo "all checks passed"
